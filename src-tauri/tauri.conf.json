{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vrun.clip",
  "mainBinaryName": "vrun-clip",
  "version": "0.1.3",
  "identifier": "com.vrun.clip",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vrun.clip",
        "width": 760,
        "height": 480,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: vclip: http://vclip.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyM0NBQjkwQzM3QjRBNDMKUldSRFNudkRrS3M4OHNDaWYzMXlhcld6ZWJ1QW56M0pENEV0b3I3L0dYNnhsQmJCODlJaDUzNGwK",
      "endpoints": ["https://github.com/Vitnerp/vrun-clip/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "vrun",
    "shortDescription": "Fast, searchable clipboard history",
    "longDescription": "vrun.clip keeps a searchable history of everything you copy. Press Ctrl+Shift+V to find and paste it again.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
