; Extra steps for the NSIS installer generated by Tauri.

!macro NSIS_HOOK_POSTUNINSTALL
  ; Remove the "Start with Windows" entry created by tauri-plugin-autostart.
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "vrun.clip"
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run" "vrun.clip"
!macroend
